# 水墨屏数据管理系统 - 环境变量配置
# 复制此文件为 .env 并修改配置值

# 应用配置
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# 数据库配置
DATABASE_URL=mysql+pymysql://user:password@host:3306/goods
DATABASE_URL_STOREDB=mysql+pymysql://user:password@host:3306/storedb
DATABASE_URL_ESLWORKING=mysql+pymysql://user:password@host:3306/eslworking

# Session 安全配置 (生产环境设为 true)
SESSION_COOKIE_SECURE=false

# 外部服务配置 (Prismart API)
PRISMART_BASE_URL=http://20.203.201.251:8090
PRISMART_USERNAME=hs-admin
PRISMART_PASSWORD=000000
PRISMART_CUSTOMER_CODE=hs
PRISMART_STORE_CODE=101

# 注册邀请码
INVITATION_CODE=jushi
